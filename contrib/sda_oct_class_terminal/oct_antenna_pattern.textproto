# SDA OCT Standard 3.1.0 class space terminal aperture. Aperture and divergence are ASSUMED representative
# values (see README.md); the standard fixes the delivered irradiance (OCT-038), not the optics.
group {
  type: ANTENNA_PATTERN
}
id: "gain/payload/optical/sda-oct-class-terminal"
antenna_pattern {
  gaussian_optical_pattern: {
    diameter_m: 0.08                 # assumed
    efficiency_percent: 0.60         # assumed
    divergence_angle_rad: 0.00002    # assumed, 20 urad 1/e^2 half-angle
    pointing_error_rad: 0.000004     # assumed, 4 urad rms
  }
}
