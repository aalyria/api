# Optical ground station aperture for the space-to-ground link. All values ASSUMED (see README.md).
group {
  type: ANTENNA_PATTERN
}
id: "gain/ground/optical/ogs-0.4m"
antenna_pattern {
  gaussian_optical_pattern: {
    diameter_m: 0.40                 # assumed
    efficiency_percent: 0.60         # assumed
    divergence_angle_rad: 0.00002    # assumed (uplink beacon-class beam)
    pointing_error_rad: 0.000004     # assumed
  }
}
